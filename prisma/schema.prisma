// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DocumentEntityType {
  OWNER
  TENANT
  PROPERTY
  LEASE
}

enum ClientRole {
  OWNER
  TENANT
  BUYER
  PROSPECT
  GUARANTOR
}

enum ClientMaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  COMMON_LAW
}

enum ClientCommunicationChannel {
  EMAIL
  SMS
  CALL
  WHATSAPP
  MESSAGE
  FORMAL_REQUEST
}

enum ClientRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClientRiskDocumentType {
  INCOME_PROOF
  PERSONAL_REFERENCE
  LABOR_REFERENCE
  CREDIT_REPORT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  ARCHIVED
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum ReferenceType {
  PERSONAL
  LABOR
  COMMERCIAL
}

enum PaymentCategory {
  RENT_CANON
  RESERVATION
  SECURITY_DEPOSIT
  CONTRACT_FEE
  CONDO_FEE
  ELECTRICITY
  INTERNET
  OTHER_SERVICE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum CurrencyCode {
  USD
  EUR
  MXN
  COP
  ARS
  CLP
  PEN
  BRL
  OTHER
}

enum IssueStatus {
  REPORTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum IssueReportedByType {
  CLIENT
  OWNER
  USER
  SYSTEM
}

enum NotificationType {
  LEASE_EXPIRATION
  RENOVATION_PROPOSAL
  OWNER_NOTICE
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  OFFICE
  COMMERCIAL
  WAREHOUSE
  LAND
  PARKING
  OTHER
}

enum VisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterestStatus {
  NEW
  CONTACTED
  VISITING
  NEGOTIATING
  CONVERTED
  DISCARDED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum RenewalMode {
  MANUAL
  AUTOMATIC
  NONE
}

enum PriceAdjustmentType {
  NONE
  FIXED_AMOUNT
  PERCENTAGE
  INDEX
}

enum LateFeeType {
  NONE
  FIXED
  PERCENT_DAILY
  PERCENT_MONTHLY
}

enum SettlementStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum SignatureStatus {
  NOT_REQUIRED
  PENDING
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

enum SignatureMethod {
  NONE
  ELECTRONIC
  DIGITAL_CERTIFICATE
  WET_SIGNATURE
}

enum UserRole {
  ADMIN
  AGENT
  ASSISTANT
  ACCOUNTANT
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NoticeRecipient {
  OWNER
  TENANT
}

enum AccountStatementAudience {
  OWNER
  TENANT
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetStatus {
  ACTIVE
  UNDER_REPAIR
  RETIRED
}

enum ProviderType {
  LABOR
  MATERIALS
  SERVICE
  MAINTENANCE
  OTHER
}

enum TaskCategory {
  REVIEW
  MAINTENANCE
  PAYMENT
  CONTRACT
  VISIT
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationType {
  VISIT
  LEASE_HOLD
  MAINTENANCE
  BLOCK
}

// ---------------------------------------------------------------------------
// Users & auditing
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  fullName     String     @map("full_name")
  phone        String?
  role         UserRole   @default(AGENT)
  status       UserStatus @default(ACTIVE)
  passwordHash String?    @map("password_hash")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  auditLogs            AuditLog[]
  propertyComments     PropertyComment[]
  propertyReviews      PropertyReview[]
  uploadedDocuments    EntityDocument[]
  signatureEvents      ContractSignatureEvent[]
  propertyIssues       PropertyIssue[]
  contractTemplates    ContractTemplate[]
  clientCommunications ClientCommunication[]
  accountStatements    AccountStatement[]
  ownerSettlements     OwnerSettlement[]
  assets               Asset[]                  @relation("AssetCreatedBy")
  providers            ServiceProvider[]        @relation("ProviderCreatedBy")
  plans                MaintenancePlan[]        @relation("PlanCreatedBy")
  tasksAssigned        Task[]                   @relation("TaskAssignee")
  tasksCreated         Task[]                   @relation("TaskCreatedBy")
  reservations         PropertyReservation[]    @relation("ReservationCreatedBy")

  @@index([role, status])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  changes    Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Clients (unified: tenants + owners live here)
// ---------------------------------------------------------------------------

model ClientProfile {
  id                        String               @id @default(uuid())
  fullName                  String               @map("full_name")
  legalDocumentId           String               @unique @map("legal_document_id")
  maritalStatus             ClientMaritalStatus? @map("marital_status")
  email                     String?
  phone                     String
  alternatePhone            String?              @map("alternate_phone")
  address                   String?
  city                      String?
  role                      ClientRole           @default(PROSPECT)
  status                    ClientStatus         @default(ACTIVE)
  riskLevel                 ClientRiskLevel      @default(MEDIUM) @map("risk_level")
  riskSummary               String?              @map("risk_summary")
  notes                     String?
  bankDetails               String?              @map("bank_details")
  workPlace                 String?              @map("work_place")
  monthlyIncome             Decimal?             @map("monthly_income") @db.Decimal(12, 2)
  emergencyContactName      String?              @map("emergency_contact_name")
  emergencyContactPhone     String?              @map("emergency_contact_phone")
  preferredPropertyType     String?              @map("preferred_property_type")
  maxBudget                 Decimal?             @map("max_budget") @db.Decimal(12, 2)
  housingRequirement        String?              @map("housing_requirement")
  identityDocumentExpiresAt DateTime?            @map("identity_document_expires_at")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")

  references        ClientReference[]
  communications    ClientCommunication[]
  riskDocuments     ClientRiskDocument[]
  leaseClients      LeaseClient[]
  properties        Property[]
  propertyIssues    PropertyIssue[]
  interests         PropertyInterest[]
  visits            PropertyVisit[]
  documents         EntityDocument[]
  guarantors        LeaseGuarantor[]
  accountStatements AccountStatement[]
  settlements       OwnerSettlement[]
  tasks             Task[]
  reservations      PropertyReservation[]

  @@index([role, status])
  @@map("client_profiles")
}

model ClientReference {
  id            String        @id @default(uuid())
  clientId      String        @map("client_id")
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referenceType ReferenceType @default(PERSONAL) @map("reference_type")
  fullName      String        @map("full_name")
  relationship  String?
  company       String?
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("client_references")
}

model ClientCommunication {
  id             String                     @id @default(uuid())
  clientId       String                     @map("client_id")
  client         ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel        ClientCommunicationChannel
  direction      CommunicationDirection     @default(OUTBOUND)
  subject        String?
  content        String
  relatedRequest String?                    @map("related_request")
  createdById    String?                    @map("created_by_id")
  createdBy      User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("client_communications")
}

model ClientRiskDocument {
  id           String                 @id @default(uuid())
  clientId     String                 @map("client_id")
  client       ClientProfile          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType ClientRiskDocumentType @map("document_type")
  title        String
  fileUrl      String?                @map("file_url")
  notes        String?
  uploadedAt   DateTime               @default(now()) @map("uploaded_at")

  @@index([clientId, uploadedAt])
  @@map("client_risk_documents")
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

model Property {
  id                       String                @id @default(uuid())
  code                     String                @unique
  ownerId                  String                @map("owner_id")
  owner                    ClientProfile         @relation(fields: [ownerId], references: [id])
  title                    String
  address                  String
  city                     String
  latitude                 Float?
  longitude                Float?
  propertyType             PropertyType          @default(APARTMENT) @map("property_type")
  totalAreaSqm             Float?                @map("total_area_sqm")
  builtAreaSqm             Float?                @map("built_area_sqm")
  bedrooms                 Int?
  bathrooms                Int?
  parkingSpaces            Int?                  @map("parking_spaces")
  amenities                Json                  @default("[]")
  customFields             Json                  @default("{}") @map("custom_fields")
  condoName                String?               @map("condo_name")
  condoAccountNumber       String?               @map("condo_account_number")
  electricityAccountNumber String?               @map("electricity_account_number")
  internetProvider         String?               @map("internet_provider")
  internetAccountNumber    String?               @map("internet_account_number")
  condoAdministration      String?               @map("condo_administration")
  condoFeeAmount           Decimal?              @map("condo_fee_amount") @db.Decimal(10, 2)
  condoContact             String?               @map("condo_contact")
  electricityProvider      String?               @map("electricity_provider")
  electricityMeterNumber   String?               @map("electricity_meter_number")
  electricityTariff        String?               @map("electricity_tariff")
  videoUrl                 String?               @map("video_url")
  floorPlanUrl             String?               @map("floor_plan_url")
  virtualTourUrl           String?               @map("virtual_tour_url")
  captureCommission        Decimal?              @map("capture_commission") @db.Decimal(5, 2)
  captureExclusive         Boolean               @default(false) @map("capture_exclusive")
  captureContractUrl       String?               @map("capture_contract_url")
  status                   PropertyStatus        @default(AVAILABLE)
  photos                   PropertyPhoto[]
  interests                PropertyInterest[]
  comments                 PropertyComment[]
  reviews                  PropertyReview[]
  leases                   Lease[]
  transactions             Transaction[]
  issues                   PropertyIssue[]
  documents                EntityDocument[]
  keys                     PropertyKey[]
  visits                   PropertyVisit[]
  accountStatements        AccountStatement[]
  assets                   Asset[]
  maintenancePlans         MaintenancePlan[]
  tasks                    Task[]
  reservations             PropertyReservation[]
  tags                     PropertyTag[]
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  deletedAt                DateTime?             @map("deleted_at")

  @@index([ownerId])
  @@index([status])
  @@index([propertyType])
  @@index([deletedAt])
  @@map("properties")
}

model PropertyKey {
  id         String    @id @default(uuid())
  propertyId String    @map("property_id")
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  holderName String    @map("holder_name")
  holderRole String    @map("holder_role")
  keyCount   Int       @default(1) @map("key_count")
  accessCode String?   @map("access_code")
  notes      String?
  assignedAt DateTime  @default(now()) @map("assigned_at")
  returnedAt DateTime? @map("returned_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([propertyId, isActive])
  @@map("property_keys")
}

model PropertyVisit {
  id           String         @id @default(uuid())
  propertyId   String         @map("property_id")
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId     String?        @map("client_id")
  client       ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  visitorName  String         @map("visitor_name")
  visitorPhone String?        @map("visitor_phone")
  visitorEmail String?        @map("visitor_email")
  purpose      String?
  scheduledAt  DateTime       @map("scheduled_at")
  visitedAt    DateTime?      @map("visited_at")
  status       VisitStatus    @default(SCHEDULED)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([propertyId, scheduledAt])
  @@map("property_visits")
}

model PropertyPhoto {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photoUrl    String   @map("photo_url")
  description String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  @@map("property_photos")
}

model PropertyInterest {
  id         String         @id @default(uuid())
  propertyId String         @map("property_id")
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId   String?        @map("client_id")
  client     ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fullName   String         @map("full_name")
  email      String?
  phone      String?
  source     String?
  status     InterestStatus @default(NEW)
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([propertyId, createdAt])
  @@map("property_interests")
}

model PropertyComment {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String?  @map("author_id")
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("Equipo") @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId, createdAt])
  @@map("property_comments")
}

model PropertyReview {
  id           String   @id @default(uuid())
  propertyId   String   @map("property_id")
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewerId   String?  @map("reviewer_id")
  reviewer     User?    @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName String   @map("reviewer_name")
  rating       Int
  comment      String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([propertyId, createdAt])
  @@map("property_reviews")
}

// ---------------------------------------------------------------------------
// Leases
// ---------------------------------------------------------------------------

model Lease {
  id                   String                   @id @default(uuid())
  propertyId           String                   @map("property_id")
  property             Property                 @relation(fields: [propertyId], references: [id])
  leaseClients         LeaseClient[]
  contractNumber       String                   @unique @map("contract_number")
  startDate            DateTime                 @map("start_date")
  endDate              DateTime                 @map("end_date")
  monthlyCanonAmount   Decimal                  @map("monthly_canon_amount") @db.Decimal(10, 2)
  currency             CurrencyCode             @default(USD)
  depositAmount        Decimal                  @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)
  reservationAmount    Decimal                  @default(0.00) @map("reservation_amount") @db.Decimal(10, 2)
  contractFeeAmount    Decimal                  @default(0.00) @map("contract_fee_amount") @db.Decimal(10, 2)
  contractFileUrl      String?                  @map("contract_file_url")
  isActive             Boolean                  @default(true) @map("is_active")
  contractStatus       ContractStatus           @default(DRAFT) @map("contract_status")
  renewalMode          RenewalMode              @default(MANUAL) @map("renewal_mode")
  renewalNoticeDays    Int                      @default(30) @map("renewal_notice_days")
  priceAdjustmentType  PriceAdjustmentType      @default(NONE) @map("price_adjustment_type")
  priceAdjustmentValue Decimal?                 @map("price_adjustment_value") @db.Decimal(8, 4)
  priceAdjustmentIndex String?                  @map("price_adjustment_index")
  nextAdjustmentDate   DateTime?                @map("next_adjustment_date")
  lateFeeType          LateFeeType              @default(NONE) @map("late_fee_type")
  lateFeeValue         Decimal?                 @map("late_fee_value") @db.Decimal(8, 4)
  lateFeeGraceDays     Int                      @default(0) @map("late_fee_grace_days")
  templateId           String?                  @map("template_id")
  template             ContractTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  draftContent         String?                  @map("draft_content")
  transactions         Transaction[]
  notices              LeaseProposalAndNotice[]
  documents            EntityDocument[]
  signatureEvents      ContractSignatureEvent[]
  guarantors           LeaseGuarantor[]
  signature            LeaseSignature?
  tasks                Task[]
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")

  @@index([propertyId])
  @@index([contractStatus])
  @@index([endDate])
  @@index([nextAdjustmentDate])
  @@index([deletedAt])
  @@index([isActive, endDate])
  @@map("leases")
}

model LeaseClient {
  id        String        @id @default(uuid())
  leaseId   String        @map("lease_id")
  lease     Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  clientId  String        @map("client_id")
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Restrict)
  role      ClientRole    @default(TENANT)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([leaseId, clientId, role])
  @@index([clientId, role])
  @@map("lease_clients")
}

model LeaseGuarantor {
  id              String         @id @default(uuid())
  leaseId         String         @map("lease_id")
  lease           Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  clientId        String?        @map("client_id")
  client          ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fullName        String         @map("full_name")
  legalDocumentId String?        @map("legal_document_id")
  phone           String?
  email           String?
  relationship    String?
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([leaseId])
  @@map("lease_guarantors")
}

model LeaseSignature {
  id                 String          @id @default(uuid())
  leaseId            String          @unique @map("lease_id")
  lease              Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  provider           String?
  envelopeId         String?         @map("envelope_id")
  status             SignatureStatus @default(NOT_REQUIRED)
  method             SignatureMethod @default(NONE)
  signedBy           String?         @map("signed_by")
  signatureHash      String?         @map("signature_hash")
  signatureData      String?         @map("signature_data")
  signatureConsentAt DateTime?       @map("signature_consent_at")
  signedAt           DateTime?       @map("signed_at")
  signedIp           String?         @map("signed_ip")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("lease_signatures")
}

model ContractTemplate {
  id           String   @id @default(uuid())
  name         String
  contractType String   @default("LEASE") @map("contract_type")
  description  String?
  content      String
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by_id")
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  leases       Lease[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("contract_templates")
}

model ContractSignatureEvent {
  id        String   @id @default(uuid())
  leaseId   String   @map("lease_id")
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  provider  String
  eventType String   @map("event_type")
  status    String
  ipAddress String?  @map("ip_address")
  actorName String?  @map("actor_name")
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leaseId, createdAt])
  @@map("contract_signature_events")
}

// ---------------------------------------------------------------------------
// Transactions & issues
// ---------------------------------------------------------------------------

model Transaction {
  id              String          @id @default(uuid())
  propertyId      String          @map("property_id")
  property        Property        @relation(fields: [propertyId], references: [id])
  leaseId         String?         @map("lease_id")
  lease           Lease?          @relation(fields: [leaseId], references: [id])
  category        PaymentCategory
  amount          Decimal         @db.Decimal(10, 2)
  currency        CurrencyCode    @default(USD)
  status          PaymentStatus   @default(PAID)
  paymentDate     DateTime        @map("payment_date")
  dueDate         DateTime?       @map("due_date")
  paymentMethod   String          @map("payment_method")
  referenceNumber String?         @map("reference_number")
  receiptUrl      String?         @map("receipt_url")
  receiptNumber   String?         @unique @map("receipt_number")
  receiptIssuedAt DateTime?       @map("receipt_issued_at")
  description     String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([leaseId])
  @@index([paymentDate])
  @@index([status])
  @@index([category])
  @@index([propertyId, paymentDate])
  @@map("transactions")
}

model DocumentSequence {
  id        String   @id @default(uuid())
  key       String   @unique
  prefix    String
  nextValue Int      @default(1) @map("next_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("document_sequences")
}

model OwnerSettlement {
  id                String           @id @default(uuid())
  settlementNumber  String           @unique @map("settlement_number")
  ownerId           String           @map("owner_id")
  owner             ClientProfile    @relation(fields: [ownerId], references: [id])
  periodStart       DateTime         @map("period_start")
  periodEnd         DateTime         @map("period_end")
  currency          CurrencyCode     @default(USD)
  grossIncome       Decimal          @default(0.00) @map("gross_income") @db.Decimal(12, 2)
  agencyCommission  Decimal          @default(0.00) @map("agency_commission") @db.Decimal(12, 2)
  commissionRate    Decimal          @default(0.00) @map("commission_rate") @db.Decimal(6, 4)
  expenses          Decimal          @default(0.00) @map("expenses") @db.Decimal(12, 2)
  lateFees          Decimal          @default(0.00) @map("late_fees") @db.Decimal(12, 2)
  netPayout         Decimal          @default(0.00) @map("net_payout") @db.Decimal(12, 2)
  status            SettlementStatus @default(DRAFT)
  notes             String?
  summary           Json             @default("{}")
  documentUrl       String?          @map("document_url")
  createdById       String?          @map("created_by_id")
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([ownerId, periodEnd])
  @@index([status, periodEnd])
  @@map("owner_settlements")
}

model PropertyIssue {
  id               String              @id @default(uuid())
  propertyId       String              @map("property_id")
  property         Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId         String?             @map("client_id")
  client           ClientProfile?      @relation(fields: [clientId], references: [id])
  reportDate       DateTime            @default(now()) @map("report_date")
  issueType        String              @map("issue_type")
  description      String
  status           IssueStatus         @default(REPORTED)
  reportedByType   IssueReportedByType @default(CLIENT) @map("reported_by_type")
  reportedByUserId String?             @map("reported_by_user_id")
  reportedByUser   User?               @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  providerId       String?             @map("provider_id")
  provider         ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  repairDate       DateTime?           @map("repair_date")
  repairDetails    String?             @map("repair_details")
  repairCost       Decimal             @default(0.00) @map("repair_cost") @db.Decimal(10, 2)
  receiptUrl       String?             @map("receipt_url")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status])
  @@index([reportDate])
  @@map("property_issues")
}

model LeaseProposalAndNotice {
  id                  String           @id @default(uuid())
  leaseId             String           @map("lease_id")
  lease               Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  noticeType          NotificationType @map("notice_type")
  recipientType       NoticeRecipient? @map("recipient_type")
  status              ProposalStatus   @default(DRAFT)
  title               String?
  body                String?
  issueDate           DateTime         @default(now()) @map("issue_date")
  sentAt              DateTime?        @map("sent_at")
  proposedCanonAmount Decimal?         @map("proposed_canon_amount") @db.Decimal(10, 2)
  proposedStartDate   DateTime?        @map("proposed_start_date")
  proposedEndDate     DateTime?        @map("proposed_end_date")
  documentUrl         String?          @map("document_url")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("lease_proposals_and_notices")
}

model AccountStatement {
  id          String                   @id @default(uuid())
  audience    AccountStatementAudience @default(OWNER)
  propertyId  String?                  @map("property_id")
  property    Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  clientId    String?                  @map("client_id")
  client      ClientProfile?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  periodStart DateTime?                @map("period_start")
  periodEnd   DateTime?                @map("period_end")
  summary     Json                     @default("{}")
  documentUrl String?                  @map("document_url")
  createdById String?                  @map("created_by_id")
  createdBy   User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now()) @map("created_at")

  @@index([propertyId, createdAt])
  @@index([clientId, createdAt])
  @@map("account_statements")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model EntityDocument {
  id           String             @id @default(uuid())
  entityType   DocumentEntityType @map("entity_type")
  clientId     String?            @map("client_id")
  client       ClientProfile?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId   String?            @map("property_id")
  property     Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId      String?            @map("lease_id")
  lease        Lease?             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  documentName String             @map("document_name")
  fileUrl      String             @map("file_url")
  uploadedById String?            @map("uploaded_by_id")
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime           @default(now()) @map("uploaded_at")

  @@index([entityType, clientId])
  @@index([entityType, propertyId])
  @@index([entityType, leaseId])
  @@map("entity_documents")
}

// ---------------------------------------------------------------------------
// Property management: assets, providers, maintenance, tasks, reservations, tags
// ---------------------------------------------------------------------------

model Asset {
  id               String            @id @default(uuid())
  propertyId       String            @map("property_id")
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name             String
  category         String?
  brand            String?
  model            String?
  serialNumber     String?           @map("serial_number")
  quantity         Int               @default(1)
  condition        AssetCondition    @default(GOOD)
  status           AssetStatus       @default(ACTIVE)
  location         String?
  purchaseDate     DateTime?         @map("purchase_date")
  purchaseValue    Decimal?          @map("purchase_value") @db.Decimal(12, 2)
  currency         CurrencyCode      @default(USD)
  notes            String?
  createdById      String?           @map("created_by_id")
  createdBy        User?             @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  maintenancePlans MaintenancePlan[]
  tasks            Task[]

  @@index([propertyId, status])
  @@map("assets")
}

model ServiceProvider {
  id               String            @id @default(uuid())
  companyName      String            @map("company_name")
  contactName      String?           @map("contact_name")
  type             ProviderType      @default(OTHER)
  taxId            String?           @map("tax_id")
  phone            String
  email            String?
  address          String?
  specialty        String?
  rating           Int?
  notes            String?
  isActive         Boolean           @default(true) @map("is_active")
  createdById      String?           @map("created_by_id")
  createdBy        User?             @relation("ProviderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  maintenancePlans MaintenancePlan[]
  tasks            Task[]
  issues           PropertyIssue[]

  @@index([type, isActive])
  @@map("service_providers")
}

model MaintenancePlan {
  id              String              @id @default(uuid())
  propertyId      String              @map("property_id")
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assetId         String?             @map("asset_id")
  asset           Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  providerId      String?             @map("provider_id")
  provider        ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  category        TaskCategory        @default(MAINTENANCE)
  frequency       RecurrenceFrequency @default(MONTHLY)
  intervalCount   Int                 @default(1) @map("interval_count")
  nextDueDate     DateTime            @map("next_due_date")
  lastCompletedAt DateTime?           @map("last_completed_at")
  isActive        Boolean             @default(true) @map("is_active")
  createdById     String?             @map("created_by_id")
  createdBy       User?               @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  tasks           Task[]

  @@index([nextDueDate, isActive])
  @@index([propertyId])
  @@map("maintenance_plans")
}

model Task {
  id          String              @id @default(uuid())
  title       String
  description String?
  category    TaskCategory        @default(OTHER)
  status      TaskStatus          @default(PENDING)
  priority    TaskPriority        @default(MEDIUM)
  dueDate     DateTime            @map("due_date")
  startAt     DateTime?           @map("start_at")
  endAt       DateTime?           @map("end_at")
  allDay      Boolean             @default(true) @map("all_day")
  completedAt DateTime?           @map("completed_at")
  recurrence  RecurrenceFrequency @default(ONCE)
  planId      String?             @map("plan_id")
  plan        MaintenancePlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  propertyId  String?             @map("property_id")
  property    Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId    String?             @map("client_id")
  client      ClientProfile?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leaseId     String?             @map("lease_id")
  lease       Lease?              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  providerId  String?             @map("provider_id")
  provider    ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  assetId     String?             @map("asset_id")
  asset       Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assigneeId  String?             @map("assignee_id")
  assignee    User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?             @map("created_by_id")
  createdBy   User?               @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([dueDate, status])
  @@index([propertyId, dueDate])
  @@index([assigneeId, dueDate])
  @@index([status, category])
  @@map("tasks")
}

model PropertyReservation {
  id          String            @id @default(uuid())
  propertyId  String            @map("property_id")
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        ReservationType   @default(VISIT)
  status      ReservationStatus @default(PENDING)
  startDate   DateTime          @map("start_date")
  endDate     DateTime          @map("end_date")
  clientId    String?           @map("client_id")
  client      ClientProfile?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String?           @map("created_by_id")
  createdBy   User?             @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([propertyId, startDate])
  @@index([status, startDate])
  @@map("property_reservations")
}

model Tag {
  id         String        @id @default(uuid())
  name       String        @unique
  color      String        @default("#64748b")
  createdAt  DateTime      @default(now()) @map("created_at")
  properties PropertyTag[]

  @@map("tags")
}

model PropertyTag {
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([propertyId, tagId])
  @@map("property_tags")
}
