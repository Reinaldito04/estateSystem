// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentEntityType {
  OWNER
  TENANT
  PROPERTY
  LEASE
}

enum ClientRole {
  OWNER
  TENANT
  BUYER
  PROSPECT
  GUARANTOR
}

enum ClientMaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  COMMON_LAW
}

enum ClientCommunicationChannel {
  EMAIL
  SMS
  CALL
  WHATSAPP
  MESSAGE
  FORMAL_REQUEST
}

enum ClientRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClientRiskDocumentType {
  INCOME_PROOF
  PERSONAL_REFERENCE
  LABOR_REFERENCE
  CREDIT_REPORT
}

enum PaymentCategory {
  RENT_CANON
  RESERVATION
  SECURITY_DEPOSIT
  CONTRACT_FEE
  CONDO_FEE
  ELECTRICITY
  INTERNET
  OTHER_SERVICE
}

enum IssueStatus {
  REPORTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum NotificationType {
  LEASE_EXPIRATION
  RENOVATION_PROPOSAL
  OWNER_NOTICE
}

model ClientProfile {
  id                       String                  @id @default(uuid())
  fullName                 String
  legalDocumentId          String                  @unique
  maritalStatus            ClientMaritalStatus?
  email                    String?
  phone                    String
  alternatePhone           String?
  address                  String?
  city                     String?
  role                     ClientRole              @default(PROSPECT)
  status                   String                 @default("active")
  riskLevel                ClientRiskLevel         @default(MEDIUM)
  riskSummary              String?
  notes                    String?
  bankDetails              String?
  workPlace                String?
  monthlyIncome            Decimal?                @db.Decimal(12, 2)
  emergencyContactName     String?
  emergencyContactPhone    String?
  preferredPropertyType    String?
  maxBudget                Decimal?                @db.Decimal(12, 2)
  housingRequirement       String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  references               ClientReference[]
  communications           ClientCommunication[]
  riskDocuments            ClientRiskDocument[]

  @@index([role, status])
}

model ClientReference {
  id             String   @id @default(uuid())
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referenceType  String   @default("PERSONAL")
  fullName       String
  relationship   String?
  company        String?
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientCommunication {
  id              String                    @id @default(uuid())
  clientId        String
  client          ClientProfile             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel         ClientCommunicationChannel
  direction       String                    @default("OUTBOUND")
  subject         String?
  content         String
  relatedRequest  String?
  createdAt       DateTime                  @default(now())

  @@index([clientId, createdAt])
}

model ClientRiskDocument {
  id             String                  @id @default(uuid())
  clientId       String
  client         ClientProfile           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType   ClientRiskDocumentType
  title          String
  fileUrl        String?
  notes          String?
  uploadedAt     DateTime                @default(now())

  @@index([clientId, uploadedAt])
}

model Owner {
  id             String     @id @default(uuid())
  fullName       String
  documentId     String     @unique
  email          String?
  phone          String
  alternatePhone String?
  address        String?
  bankDetails    String?
  identityDocumentExpiresAt DateTime?
  properties     Property[]
  documents      EntityDocument[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Tenant {
  id                    String          @id @default(uuid())
  fullName              String
  documentId            String          @unique
  email                 String?
  phone                 String
  workPlace             String?
  monthlyIncome         Decimal?        @db.Decimal(12, 2)
  emergencyContactName  String?
  emergencyContactPhone String?
  identityDocumentExpiresAt DateTime?
  leases                Lease[]
  propertyIssues        PropertyIssue[]
  documents             EntityDocument[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model EntityDocument {
  id           String             @id @default(uuid())
  entityType   DocumentEntityType
  ownerId      String?
  owner        Owner?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId      String?
  lease        Lease?             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  documentName String
  fileUrl      String
  uploadedAt   DateTime           @default(now())

  @@index([entityType, ownerId])
  @@index([entityType, tenantId])
  @@index([entityType, propertyId])
  @@index([entityType, leaseId])
}

model Property {
  id                       String          @id @default(uuid())
  code                     String          @unique
  ownerId                  String
  owner                    Owner           @relation(fields: [ownerId], references: [id])
  title                    String
  address                  String
  city                     String
  latitude                 Float?
  longitude                Float?
  propertyType             String          @default("APARTMENT")
  totalAreaSqm             Float?
  builtAreaSqm             Float?
  bedrooms                 Int?
  bathrooms                Int?
  parkingSpaces            Int?
  amenities                Json            @default("[]")
  customFields             Json            @default("{}")
  condoName                String?
  condoAccountNumber       String?
  electricityAccountNumber String?
  internetProvider         String?
  internetAccountNumber    String?
  videoUrl                 String?
  floorPlanUrl             String?
  virtualTourUrl           String?
  captureCommission        Decimal?        @db.Decimal(5, 2)
  captureExclusive         Boolean         @default(false)
  captureContractUrl       String?
  status                   String          @default("available")
  photos                   PropertyPhoto[]
  interests                PropertyInterest[]
  comments                 PropertyComment[]
  reviews                  PropertyReview[]
  leases                   Lease[]
  transactions             Transaction[]
  issues                   PropertyIssue[]
  documents                EntityDocument[]
  keys                     PropertyKey[]
  visits                   PropertyVisit[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model PropertyKey {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  holderName  String
  holderRole  String
  keyCount    Int      @default(1)
  accessCode  String?
  notes       String?
  assignedAt  DateTime @default(now())
  returnedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId, isActive])
}

model PropertyVisit {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String?
  visitorEmail String?
  purpose      String?
  scheduledAt  DateTime
  visitedAt    DateTime?
  status       String   @default("scheduled")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId, scheduledAt])
}

model PropertyPhoto {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photoUrl    String
  description String?
  uploadedAt  DateTime @default(now())
}

model PropertyInterest {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fullName   String
  email      String?
  phone      String?
  source     String?
  status     String   @default("new")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId, createdAt])
}

model PropertyComment {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorName String   @default("Equipo")
  content    String
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

model PropertyReview {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewerName String
  rating       Int
  comment      String
  createdAt    DateTime @default(now())

  @@index([propertyId, createdAt])
}

model Lease {
  id                 String                     @id @default(uuid())
  propertyId         String
  property           Property                   @relation(fields: [propertyId], references: [id])
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  contractNumber     String                     @unique
  startDate          DateTime
  endDate            DateTime
  monthlyCanonAmount Decimal                    @db.Decimal(10, 2)
  depositAmount      Decimal                    @default(0.00) @db.Decimal(10, 2)
  reservationAmount  Decimal                    @default(0.00) @db.Decimal(10, 2)
  contractFeeAmount  Decimal                    @default(0.00) @db.Decimal(10, 2)
  contractFileUrl    String?
  isActive           Boolean                    @default(true)
  contractStatus     String                     @default("DRAFT")
  renewalMode        String                     @default("MANUAL")
  renewalNoticeDays  Int                        @default(30)
  priceAdjustmentType String                    @default("NONE")
  priceAdjustmentValue Decimal?                 @db.Decimal(8, 4)
  priceAdjustmentIndex String?
  nextAdjustmentDate DateTime?
  guarantorRequired  Boolean                    @default(false)
  guarantorName      String?
  guarantorDocumentId String?
  guarantorPhone     String?
  guarantorEmail     String?
  templateId         String?
  template           ContractTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  draftContent       String?
  signatureProvider  String?
  signatureEnvelopeId String?
  signatureStatus    String                     @default("NOT_REQUIRED")
  signatureMethod    String                     @default("NONE")
  signedBy           String?
  signatureHash      String?
  signatureData      String?
  signatureConsentAt DateTime?
  signedAt           DateTime?
  signedIp           String?
  transactions       Transaction[]
  notices            LeaseProposalAndNotice[]
  documents          EntityDocument[]
  signatureEvents    ContractSignatureEvent[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model ContractTemplate {
  id           String   @id @default(uuid())
  name         String
  contractType String   @default("LEASE")
  description  String?
  content      String
  isActive     Boolean  @default(true)
  leases       Lease[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContractSignatureEvent {
  id           String   @id @default(uuid())
  leaseId      String
  lease        Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  provider     String
  eventType    String
  status       String
  ipAddress    String?
  actorName    String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([leaseId, createdAt])
}

model Transaction {
  id              String          @id @default(uuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id])
  leaseId         String?
  lease           Lease?          @relation(fields: [leaseId], references: [id])
  category        PaymentCategory
  amount          Decimal         @db.Decimal(10, 2)
  paymentDate     DateTime
  paymentMethod   String
  referenceNumber String?
  receiptUrl      String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PropertyIssue {
  id            String      @id @default(uuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  reportDate    DateTime    @default(now())
  issueType     String
  description   String
  status        IssueStatus @default(REPORTED)
  repairDate    DateTime?
  repairDetails String?
  repairCost    Decimal     @default(0.00) @db.Decimal(10, 2)
  receiptUrl    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LeaseProposalAndNotice {
  id                  String           @id @default(uuid())
  leaseId             String
  lease               Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  noticeType          NotificationType
  issueDate           DateTime         @default(now())
  proposedCanonAmount Decimal?         @db.Decimal(10, 2)
  proposedStartDate   DateTime?
  proposedEndDate     DateTime?
  documentUrl         String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}